# 1. 飞书自建应用凭证（在飞书开放平台 -> 凭证与基础信息 中获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 2. 指定要拉取的飞书内容入口（三选一或组合使用，多个用英文逗号分隔）：
# 方式 A：云空间文件夹链接或 folder_token（需在飞书文件夹右上角「... -> 添加协作者」把你的应用加为可阅读）
FEISHU_FOLDER_TOKENS=

# 方式 B：知识库 Space ID（需在知识库设置中添加你的应用为成员）
FEISHU_WIKI_SPACE_IDS=

# 方式 C：单篇或多篇飞书文档链接 / docx_token / wiki_token（逗号分隔）
FEISHU_DOC_TOKENS=

# 3. 可选：如果你不想给每个文件夹单独添加应用机器人协作者，
# 可在飞书开放平台 API 调试台获取你个人的 user_access_token 填入此处（填入后将以你个人身份读取）
FEISHU_USER_ACCESS_TOKEN=
